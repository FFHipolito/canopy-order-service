{
  "info": {
    "_postman_id": "a9b1c2d3-e4f5-4678-90ab-cdef12345678",
    "name": "Canopy Order Service API",
    "description": "Coleção completa da API RESTful de Produtos e Pedidos desenvolvida com NestJS, Prisma e PostgreSQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Login (Gerar JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.access_token) {",
                  "    pm.collectionVariables.set('jwt_token', res.data.access_token);",
                  "    console.log('Token JWT capturado com sucesso!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@canopy.com\",\n  \"password\": \"canopy_super_secure_admin_password_2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Autentica usuário e salva o token Bearer automaticamente na variável de coleção `jwt_token`."
          }
        }
      ]
    },
    {
      "name": "2. Produtos",
      "item": [
        {
          "name": "Listar Produtos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "Rota pública que retorna todos os produtos cadastrados."
          }
        },
        {
          "name": "Listar Produtos com Filtros e Busca",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?categoria=Hardware%20IoT&busca=Sensor&ordenacao=preco&direcao=asc",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "categoria",
                  "value": "Hardware IoT"
                },
                {
                  "key": "busca",
                  "value": "Sensor"
                },
                {
                  "key": "ordenacao",
                  "value": "preco"
                },
                {
                  "key": "direcao",
                  "value": "asc"
                }
              ]
            },
            "description": "Demonstração de filtragem por categoria, busca textual e ordenação dinâmica."
          }
        },
        {
          "name": "Criar Produto (Requer JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('productId', res.data.id);",
                  "    console.log('ID do produto salvo:', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Sensor LoRaWAN Solo Pro Max\",\n  \"categoria\": \"Hardware IoT\",\n  \"descricao\": \"Sensor de telemetria avançada de umidade e condutividade elétrica para silvicultura\",\n  \"preco\": 499.90,\n  \"quantidade_estoque\": 35\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "Cria um novo produto. O ID gerado é automaticamente salvo na variável `productId`."
          }
        },
        {
          "name": "Buscar Produto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "description": "Retorna os detalhes de um produto específico pelo seu identificador UUID."
          }
        },
        {
          "name": "Atualizar Produto (Requer JWT)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preco\": 479.90,\n  \"quantidade_estoque\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "description": "Atualiza os campos de um produto existente."
          }
        },
        {
          "name": "Deletar Produto (Requer JWT)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "description": "Remove um produto que não esteja vinculado a pedidos existentes."
          }
        }
      ]
    },
    {
      "name": "3. Pedidos",
      "item": [
        {
          "name": "Listar Pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "description": "Retorna todos os pedidos com seus itens e produtos associados."
          }
        },
        {
          "name": "Criar Pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('orderId', res.data.id);",
                  "    console.log('ID do pedido salvo:', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"produtos\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantidade\": 2\n    }\n  ],\n  \"status\": \"Pendente\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "description": "Cria um novo pedido com verificação de estoque e total calculado no servidor. Salva o ID em `orderId`."
          }
        },
        {
          "name": "Buscar Pedido por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            },
            "description": "Retorna os detalhes de um pedido e sua lista de produtos agregada."
          }
        },
        {
          "name": "Atualizar Status do Pedido (Concluir e Baixar Estoque)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Concluído\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "status"]
            },
            "description": "Altera o status para 'Concluído', disparando a baixa atômica de estoque em transação ACID."
          }
        },
        {
          "name": "Cancelar Pedido (Estornar Estoque se Concluído)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Cancelado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "status"]
            },
            "description": "Cancela o pedido e estorna os itens de volta ao estoque caso estivesse concluído."
          }
        }
      ]
    }
  ]
}
